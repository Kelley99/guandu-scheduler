<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>官渡自动分配工具</title>
    <!-- TEST MARKER: 如果你看到这一行，说明 HTML 加载成功 -->
    <script>console.log('HTML loaded');</script>
<script src="https://unpkg.com/vue@3.5.33/dist/vue.global.prod.js"></script>
    <!-- 使用原生 fetch，不再依赖 axios CDN -->
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            color: #e0e0e0;
        }
        .container { max-width: 1400px; margin: 0 auto; padding: 20px; }
        h1 { text-align: center; color: #ffd700; margin-bottom: 30px; font-size: 2rem; }
        .card {
            background: rgba(255,255,255,0.97);
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            color: #333;
        }
        .card-header {
            font-size: 1.2rem;
            font-weight: bold;
            color: #1a1a2e;
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 2px solid #ffd700;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .form-row { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; }
        .form-group { flex: 1; min-width: 200px; }
        label { display: block; margin-bottom: 6px; font-weight: 500; color: #555; }
        select, input {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
        }
        select:focus, input:focus { outline: none; border-color: #ffd700; }
        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-primary { background: linear-gradient(135deg, #ffd700 0%, #ff8c00 100%); color: #1a1a2e; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(255,215,0,0.4); }
        .btn-secondary { background: #6c757d; color: white; }
        .btn-secondary:hover { background: #5a6268; }
        .btn-success { background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white; }
        .btn-success:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(40,167,69,0.4); }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
        .btn-link { background: none; border: none; color: #007bff; cursor: pointer; padding: 0; font-size: inherit; text-decoration: underline; }
        .btn-group { display: flex; gap: 12px; margin-top: 16px; flex-wrap: wrap; }
        .section-tabs { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
        .tab-btn {
            padding: 8px 16px;
            border: 2px solid #ddd;
            border-radius: 20px;
            background: white;
            cursor: pointer;
            transition: all 0.3s;
        }
        .tab-btn.active { background: #ffd700; border-color: #ffd700; color: #1a1a2e; font-weight: bold; }
        .tab-btn:hover:not(.active) { border-color: #ffd700; }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        th, td { border: 1px solid #ddd; padding: 10px 8px; text-align: left; }
        th { background: #f8f9fa; font-weight: bold; color: #1a1a2e; }
        tr:nth-child(even) { background: #f8f9fa; }
        tr:hover { background: #fff3cd; }
        .hp-high { color: #28a745; font-weight: bold; }
        .hp-mid { color: #ffc107; }
        .hp-low { color: #dc3545; }
        .hp-unknown { color: #6c757d; font-style: italic; }
        .members-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 8px;
            margin-top: 12px;
        }
        .member-chip {
            background: #e9ecef;
            padding: 8px 12px;
            border-radius: 20px;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .member-chip .hp { font-size: 11px; color: #666; }
        .modal {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.7);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }
        .modal-content {
            background: white;
            border-radius: 12px;
            padding: 24px;
            max-width: 700px;
            width: 95%;
            max-height: 85vh;
            overflow-y: auto;
        }
        .modal-header { font-size: 1.3rem; font-weight: bold; margin-bottom: 16px; color: #1a1a2e; }
        .modal-footer { display: flex; justify-content: flex-end; gap: 12px; margin-top: 20px; }
        .match-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border-bottom: 1px solid #eee;
            flex-wrap: wrap;
        }
        .match-item:last-child { border-bottom: none; }
        .match-item .orig { min-width: 120px; font-weight: bold; }
        .match-item select, .match-item input {
            flex: 1;
            min-width: 150px;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }
        .preview-section { margin-top: 20px; }
        .preview-table { font-size: 12px; }
        .preview-table th { background: #ffd700; color: #1a1a2e; }
        .stats-bar { display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 16px; }
        .stat-item {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 20px;
            border-radius: 8px;
            text-align: center;
            min-width: 100px;
        }
        .stat-item .value { font-size: 1.5rem; font-weight: bold; }
        .stat-item .label { font-size: 0.85rem; opacity: 0.9; }
        .instruction {
            background: #e7f3ff;
            border-left: 4px solid #2196F3;
            padding: 12px 16px;
            margin-bottom: 16px;
            border-radius: 0 8px 8px 0;
            color: #333;
        }
        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            margin-top: 12px;
        }
        .alert-warning { background: #fff3cd; color: #856404; border: 1px solid #ffc107; }
        .alert-danger { background: #f8d7da; color: #721c24; border: 1px solid #dc3545; }
        .alert-success { background: #d4edda; color: #155724; border: 1px solid #28a745; }
        .loading {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 2000;
        }
        .loading-content { background: white; padding: 30px 50px; border-radius: 12px; text-align: center; }
        .spinner {
            border: 3px solid #f3f3f3;
            border-top: 3px solid #ffd700;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 16px;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        small { color: #666; font-size: 12px; }
    </style>
</head>
<body>
    <!-- TEST: If you see this, HTML is loading -->
    <div style="background:red;color:white;padding:10px;font-size:20px;">如果看到这个，说明 HTML 加载了</div>
    <div style="position:fixed;top:5px;right:10px;z-index:9999;background:#ff0;padding:2px 8px;font-size:12px;color:#000;">v20260426-2100 fetch</div>
    <div id="app">
        <div class="container">
            <h1>官渡自动分配工具</h1>
            
            <!-- 调试面板 -->
            <div class="card" style="background:#ffe; border:2px solid #fc0; margin-bottom:16px">
                <div style="font-weight:bold; color:#900; margin-bottom:8px">🔧 调试状态</div>
                <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:8px; font-size:12px">
                    <div><b>statsLoaded:</b> {{ statsLoaded }}</div>
                    <div><b>statsCount:</b> {{ statsCount }}</div>
                    <div><b>members:</b> {{ members.length }}</div>
                    <div><b>benchMembers:</b> {{ benchMembers.length }}</div>
                    <div><b>matchDone:</b> {{ matchDone }}</div>
                    <div><b>nameMap:</b> {{ Object.keys(nameMap).length }}</div>
                    <div><b>unmatched:</b> {{ unmatched.length }}</div>
                    <div><b>assignmentDone:</b> {{ assignmentDone }}</div>
                    <div><b>selectedSection:</b> {{ selectedSection }}</div>
                    <div><b>guanduFilename:</b> {{ guanduFilename }}</div>
                    <div><b>sortBy:</b> {{ sortBy }}</div>
                    <div><b>sortFields:</b> {{ sortFields.map(f=>f.key).join(',') }}</div>
                </div>
                <div v-if="members.length > 0" style="margin-top:8px; font-size:11px; color:#666">
                    前3成员: {{ members.slice(0,3).map(m=>m.name||m).join(', ') }}
                </div>
                <div v-if="Object.keys(nameMap).length > 0" style="margin-top:4px; font-size:11px; color:#666">
                    nameMap前3: {{ Object.entries(nameMap).slice(0,3).map(([k,v])=>k+'→'+v).join('; ') }}
                </div>
                <div v-if="debugLog.length > 0" style="margin-top:8px; max-height:150px; overflow-y:auto; font-size:11px; background:#fff; padding:8px; border-radius:4px; border:1px solid #ddd; font-family:monospace">
                    <div v-for="(log, i) in debugLog" :key="i">{{ log }}</div>
                </div>
            </div>
            
            <!-- 步骤1: 导入数据 -->
            <div class="card">
                <div class="card-header">步骤1: 导入数据</div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>选择团</label>
                        <div class="section-tabs">
                            <button v-for="s in sections" :key="s"
                                    :class="['tab-btn', {active: selectedSection === s}]"
                                    @click="selectSection(s)">{{ s }}</button>
                        </div>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>属性表 (步兵生命值)</label>
                        <div class="btn-group" style="margin-top:0; margin-bottom:12px">
                            <label class="btn btn-primary" style="cursor:pointer">
                                📁 上传文件
                                <input type="file" @change="uploadStatsFile" accept=".xlsx,.csv,.md" style="display:none">
                            </label>
                            <button class="btn btn-secondary" @click="reloadStats">加载默认</button>
                        </div>
                        <div v-if="statsLoaded" class="alert alert-success">
                            ✅ 已加载 {{ statsCount }} 条属性数据
                            <small v-if="statsFilename"> ({{ statsFilename }})</small>
                        </div>
                        <div v-else class="instruction">
                            支持 .xlsx / .csv / .md 格式，需包含"成员名称"和"步兵生命值"列
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label>人员名单</label>
                        <div class="btn-group" style="margin-top:0; margin-bottom:12px">
                            <label class="btn btn-primary" style="cursor:pointer">
                                📁 上传文件
                                <input type="file" @change="uploadGuanduFile" accept=".xlsx,.csv,.md" style="display:none">
                            </label>
                            <button class="btn btn-secondary" @click="loadGuandu">加载默认</button>
                        </div>
                        <div v-if="members.length > 0" class="alert alert-success">
                            ✅ 已加载 {{ members.length }} 名成员
                            <small v-if="guanduFilename"> ({{ guanduFilename }})</small>
                        </div>
                        <div v-else class="instruction">
                            支持 .xlsx / .csv / .md 格式，或从官渡表加载
                        </div>
                    </div>
                </div>
                
                <!-- 正式成员 + 候补人员 分区展示 -->
                <div v-if="members.length > 0 || benchMembers.length > 0" style="margin-top:16px">
                    <!-- 正式成员 -->
                    <div v-if="members.length > 0">
                        <label style="color:#28a745;font-weight:bold">📋 正式成员 ({{ members.length }}人) — 参与排序分配</label>
                        <div class="members-grid">
                            <div v-for="(m, idx) in members" :key="'m-'+idx" class="member-chip" style="background:#d4edda;border:1px solid #28a745">
                                <span>{{ m }}</span>
                                <span class="hp" :class="getHpClass(getSortValue(m))" v-if="getSortValue(m) > 0">{{ getSortValue(m) }}</span>
                                <span class="hp hp-unknown" v-else>?</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- 候补人员 -->
                    <div v-if="benchMembers.length > 0" style="margin-top:16px">
                        <label style="color:#6c757d;font-weight:bold">📝 候补人员 ({{ benchMembers.length }}人) — 仅汇总输出</label>
                        <div class="members-grid">
                            <div v-for="(m, idx) in benchMembers" :key="'b-'+idx" class="member-chip" style="background:#f8f9fa;border:1px solid #6c757d">
                                <span style="color:#666">{{ m }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- 步骤2: 匹配成员 -->
            <div class="card" v-if="members.length > 0">
                <div class="card-header">步骤2: 匹配成员</div>
                
                <div v-if="matchDone" class="alert alert-success">
                    ✅ 已自动匹配 {{ Object.keys(nameMap).length }} 个成员
                    <span v-if="unmatched.length > 0">，{{ unmatched.length }} 个待确认</span>
                    <span v-else>，全部匹配成功！</span>
                </div>
                <div v-else-if="statsLoaded && members.length > 0" class="instruction">
                    属性表和人员名单已加载，点击"开始匹配"进行匹配
                </div>
                <div v-else class="instruction">
                    请先加载属性表和人员名单
                </div>
                
                <div class="btn-group">
                    <button class="btn btn-secondary" @click="matchMembers" :disabled="!statsLoaded || members.length === 0">
                        重新匹配
                    </button>
                </div>
                
                <!-- 未匹配成员 - 始终显示（非弹窗） -->
                <div v-if="unmatched.length > 0" style="margin-top:16px">
                    <div class="alert alert-warning" style="margin-bottom:8px">
                        ⚠️ {{ unmatched.length }} 个成员未匹配到属性数据，请手动选择对应成员
                    </div>
                    <div v-for="(item, index) in unmatched" :key="index" class="match-item" style="background:#fff;border:1px solid #ffc107;border-radius:8px;margin-bottom:8px">
                        <span class="orig" style="min-width:120px;font-weight:bold">{{ item.original }}</span>
                        <span>匹配为:</span>
                        <select v-model="item.manualMatch" style="flex:1;min-width:150px;padding:8px;border:1px solid #ddd;border-radius:4px">
                            <option value="">-- 跳过 --</option>
                            <option v-for="name in statNames" :key="name" :value="name">
                                {{ name }} ({{ getStatLabel(name) }})
                            </option>
                        </select>
                    </div>
                    <div class="btn-group">
                        <button class="btn btn-primary" @click="confirmMatches">确认匹配</button>
                        <button class="btn btn-secondary" @click="skipAll">全部跳过</button>
                    </div>
                </div>
                
                <!-- 未匹配成员弹窗（保留用于初始自动弹窗） -->
                <div v-if="showMatchModal && unmatched.length > 0" class="modal">
                    <div class="modal-content">
                        <div class="modal-header">成员名称需要确认</div>
                        <div v-for="(item, index) in unmatched" :key="index" class="match-item">
                            <span class="orig">{{ item.original }}</span>
                            <span>匹配为:</span>
                            <select v-model="item.manualMatch">
                                <option value="">-- 跳过 --</option>
                                <option v-for="name in statNames" :key="name" :value="name">
                                    {{ name }} ({{ getStatLabel(name) }})
                                </option>
                            </select>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @click="skipAll">跳过未匹配</button>
                            <button class="btn btn-primary" @click="confirmMatches">确认</button>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- 步骤3: 分组配置 -->
            <div class="card">
                <div class="card-header">步骤3: 分组配置</div>
                
                <!-- 排序字段选择 -->
                <div style="margin-bottom:16px;padding:12px;background:#e7f3ff;border-radius:4px;">
                    <div style="font-weight:bold;color:#0056b3;margin-bottom:8px">📊 排序字段</div>
                    <div style="display:flex;gap:20px;">
                        <span v-for="field in sortFields" :key="field.key">
                            <input type="radio" v-model="sortBy" :value="field.key" :id="'sort_' + field.key">
                            <span style="vertical-align:middle">{{ field.label }}</span>
                        </span>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>HP阈值</label>
                        <input type="number" v-model="threshold" min="0" max="2000" step="50">
                        <small>低于此值的成员将分配到D17-D24 (默认900)</small>
                    </div>
                    <div class="form-group">
                        <label>随机种子</label>
                        <input type="number" v-model="randomSeed" min="1" max="9999">
                        <small>相同种子产生相同结果</small>
                    </div>
                </div>
                
                <!-- 手动指定队长 -->
                <div class="manual-captains" style="margin: 16px 0; padding: 12px; background: #fff3cd; border-radius: 4px;">
                    <label style="font-weight:bold;color:#856404">🎯 手动指定队长（可选）</label>
                    <small style="display:block;color:#856404;margin-bottom:8px">手动指定的队长不参与自动排序</small>
                    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px">
                        <div v-for="pos in ['B1','B2','B3','B4','B5','B6']" :key="pos" style="display:flex;align-items:center;gap:4px">
                            <span style="font-weight:bold;min-width:28px">{{ pos }}</span>
                            <select v-model="manualCaptains[pos]" style="flex:1;padding:4px;font-size:13px">
                                <option value="">-- 自动 --</option>
                                <option v-for="m in members" :key="m" :value="m">{{ m }}</option>
                            </select>
                        </div>
                    </div>
                </div>
                
                <div class="btn-group">
                    <button class="btn btn-success" @click="runAssignment" :disabled="!statsLoaded || members.length === 0">
                        执行分配
                    </button>
                </div>
            </div>
            
            <!-- 步骤4: 预览 -->
            <div class="card" v-if="assignmentDone">
                <div class="card-header">步骤4: 预览与导出</div>
                
                <div class="stats-bar">
                    <div class="stat-item">
                        <div class="value">{{ members.length }}</div>
                        <div class="label">总人数</div>
                    </div>
                    <div class="stat-item">
                        <div class="value">{{ matchedCount }}</div>
                        <div class="label">已匹配</div>
                    </div>
                    <div class="stat-item">
                        <div class="value">{{ unmatchedCount }}</div>
                        <div class="label">未匹配</div>
                    </div>
                </div>
                
                <h3 style="margin: 16px 0 8px">B列分配 (队长)</h3>
                <table class="preview-table">
                    <thead>
                        <tr>
                            <th>位置</th>
                            <th>队长</th>
                            <th v-for="field in sortFields" :key="field.key">{{ field.label }}</th>
                            <th>排序</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="pos in bPositions" :key="pos">
                            <td><strong>{{ pos }}</strong></td>
                            <td>{{ bAssign[pos] ? bAssign[pos].original : '' }}</td>
                            <td v-for="field in sortFields" :key="field.key" :class="field.key === 'hp' ? getHpClass(bAssign[pos] ? bAssign[pos].hp : 0) : ''">{{ bAssign[pos] ? (bAssign[pos][field.key] || '-') : '-' }}</td>
                            <td>{{ getRank(pos) }}</td>
                        </tr>
                    </tbody>
                </table>
                
                <h3 style="margin: 20px 0 8px">D列分配 (队员)</h3>
                <table class="preview-table">
                    <thead>
                        <tr>
                            <th>位置</th>
                            <th>队员</th>
                            <th v-for="field in sortFields" :key="field.key">{{ field.label }}</th>
                            <th>所属队</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="pos in dPositions" :key="pos">
                            <td><strong>{{ pos }}</strong></td>
                            <td>{{ dAssign[pos] ? dAssign[pos].original : '' }}</td>
                            <td v-for="field in sortFields" :key="field.key" :class="field.key === 'hp' ? getHpClass(dAssign[pos] ? dAssign[pos].hp : 0) : ''">{{ dAssign[pos] ? (dAssign[pos][field.key] || '-') : '-' }}</td>
                            <td>{{ getTeam(pos) }}</td>
                        </tr>
                    </tbody>
                </table>
                
                <div class="btn-group">
                    <button class="btn btn-success" @click="exportExcel">导出Excel</button>
                    <button class="btn btn-secondary" @click="resetAll">重新开始</button>
                </div>
            </div>
            
            <!-- 候补名单 -->
            <div class="card" v-if="benchMembers.length > 0">
                <div class="card-header">候补名单 ({{ benchMembers.length }}人)</div>
                <div class="members-grid">
                    <div v-for="(m, idx) in benchMembers" :key="idx" class="member-chip">
                        <span>{{ m }}</span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Loading -->
        <div v-if="loading" class="loading">
            <div class="loading-content">
                <div class="spinner"></div>
                <div>{{ loadingText }}</div>
            </div>
        </div>


    </div>
    
    <script>
        try {
            const { createApp, ref, computed } = Vue;
        createApp({
            setup() {
                const sections = ref([]);
                const selectedSection = ref('');
                const stats = ref({});
                const statsLoaded = ref(false);
                const statsCount = ref(0);
                const statsFilename = ref('');
                const members = ref([]);
                const benchMembers = ref([]);
                const teamsData = ref({});
                const guanduFilename = ref('');
                const showMatchModal = ref(false);
                const unmatched = ref([]);
                const nameMap = ref({});
                const threshold = ref(900);
                const randomSeed = ref(42);
                const manualCaptains = ref({B1:'',B2:'',B3:'',B4:'',B5:'',B6:''});
                const sortBy = ref('hp');  // 动态选择: 'hp' / 'total' / 'power'
                const sortFields = ref([{key: 'hp', label: '步兵生命值'}]);  // 从属性表动态检测
                const matchDone = ref(false);
                const assignmentDone = ref(false);
                const loading = ref(false);
                const loadingText = ref('加载中...');
                const bAssign = ref({});
                const dAssign = ref({});
                const sortedMembers = ref([]);
                const debugLog = ref([]);
                const _dlog = (msg) => {
                    const t = new Date().toLocaleTimeString();
                    const line = t + ' ' + msg;
                    debugLog.value.push(line);
                    console.log(line);
                };
                
                const bPositions = ['B1','B2','B3','B4','B5','B6'];
                const dPositions = ['D1','D2','D3','D4','D5','D6','D7','D8',
                                   'D9','D10','D11','D12','D13','D14','D15','D16',
                                   'D17','D18','D19','D20','D21','D22','D23','D24'];
                
                const statNames = computed(() => Object.keys(stats.value));
                const matchedCount = computed(() => members.value.length - unmatched.value.length);
                const unmatchedCount = computed(() => unmatched.value.length);
                
                const getStatHp = (name) => {
                    const s = stats.value[name];
                    return s ? s.hp : 0;
                };
                
                const getStatTotal = (name) => {
                    const s = stats.value[name];
                    return s ? s.total : 0;
                };
                
                const getStatPower = (name) => {
                    const s = stats.value[name];
                    return s ? s.power : 0;
                };

                const getStatLabel = (name) => {
                    if (!sortFields.value.length) return '';
                    const parts = [];
                    for (const f of sortFields.value) {
                        const s = stats.value[name];
                        const v = s ? (s[f.key] || 0) : 0;
                        parts.push(v);
                    }
                    return parts.join(' / ');
                };
                
                const getHp = (name) => {
                    const mapped = nameMap.value[name] || name;
                    const s = stats.value[mapped];
                    return s ? s.hp : 0;
                };
                
                // 根据当前排序字段获取成员的对应属性值
                const getSortValue = (name) => {
                    const mapped = nameMap.value[name] || name;
                    const s = stats.value[mapped];
                    if (!s) return 0;
                    const key = sortBy.value;
                    return s[key] || 0;
                };
                
                const getHpClass = (hp) => {
                    if (!hp) return 'hp-unknown';
                    if (hp >= 1000) return 'hp-high';
                    if (hp >= 700) return 'hp-mid';
                    return 'hp-low';
                };
                
                const selectSection = async (section) => {
                    selectedSection.value = section;
                    await loadGuandu();
                };
                
                const reloadStats = async () => {
                    loading.value = true;
                    loadingText.value = '加载属性表...';
                    try {
                        const res = await fetch('/api/load_stats');
                        const json = await res.json();
                        if (json.success) {
                            stats.value = json.stats;
                            statsLoaded.value = true;
                            statsCount.value = json.count;
                            statsFilename.value = '默认文件';
                            // 动态更新排序字段
                            if (json.sort_fields && json.sort_fields.length) {
                                sortFields.value = json.sort_fields;
                                // 如果当前sortBy不在可用字段中，切换到第一个
                                if (!sortFields.value.some(f => f.key === sortBy.value)) {
                                    sortBy.value = sortFields.value[0].key;
                                }
                            }
                        }
                    } catch (e) {
                        console.error(e);
                    } finally {
                        loading.value = false;
                    }
                };
                
                const uploadStatsFile = async (event) => {
                    const file = event.target.files[0];
                    if (!file) return;
                    
                    loading.value = true;
                    loadingText.value = '上传并解析属性表...';
                    
                    const formData = new FormData();
                    formData.append('file', file);
                    
                    try {
                        const res = await fetch('/api/upload_stats', { method: 'POST', body: formData });
                        const json = await res.json();
                        if (json.success) {
                            stats.value = json.stats;
                            statsLoaded.value = true;
                            statsCount.value = json.count;
                            statsFilename.value = json.filename;
                            // 动态更新排序字段
                            if (json.sort_fields && json.sort_fields.length) {
                                sortFields.value = json.sort_fields;
                                if (!sortFields.value.some(f => f.key === sortBy.value)) {
                                    sortBy.value = sortFields.value[0].key;
                                }
                            }
                            // 如果已有人员名单，自动匹配
                            await doAutoMatch();
                        } else {
                            alert('上传失败: ' + json.error);
                        }
                    } catch (e) {
                        console.error(e);
                        alert('上传失败');
                    } finally {
                        loading.value = false;
                        event.target.value = '';
                    }
                };
                
                const loadGuandu = async () => {
                    loading.value = true;
                    loadingText.value = '加载官渡表...';
                    try {
                        const res = await fetch('/api/load_guandu?section=' + encodeURIComponent(selectedSection.value));
                        const json = await res.json();
                        if (json.success) {
                            teamsData.value = json.teams;
                            benchMembers.value = json.bench;
                            members.value = json.members;
                            guanduFilename.value = '默认文件';
                            // 自动匹配
                            await doAutoMatch();
                        }
                    } catch (e) {
                        console.error(e);
                    } finally {
                        loading.value = false;
                    }
                };
                
                const uploadGuanduFile = async (event) => {
                    const file = event.target.files[0];
                    if (!file) return;
                    _dlog('uploadGuanduFile: file=' + file.name + ' section=' + selectedSection.value);
                    
                    loading.value = true;
                    loadingText.value = '上传并解析人员名单...';
                    
                    const formData = new FormData();
                    formData.append('file', file);
                    formData.append('section', selectedSection.value);
                    
                    try {
                        const res = await fetch('/api/upload_guandu', { method: 'POST', body: formData });
                        const json = await res.json();
                        _dlog('uploadGuandu 响应: status=' + res.status + ' success=' + json.success + ' members=' + (json.members ? json.members.length : 'null') + ' error=' + (json.error || 'none'));
                        if (json.success) {
                            teamsData.value = json.teams;
                            benchMembers.value = json.bench;
                            members.value = json.members;
                            guanduFilename.value = json.filename;
                            _dlog('赋值后 members=' + members.value.length);
                            // 自动匹配
                            await doAutoMatch();
                        } else {
                            _dlog('上传失败: ' + json.error);
                            alert('上传失败: ' + json.error);
                        }
                    } catch (e) {
                        _dlog('上传异常: ' + e.message);
                        console.error(e);
                        alert('上传失败');
                    } finally {
                        loading.value = false;
                        event.target.value = '';
                    }
                };
                
                // 自动匹配（内部函数）
                const doAutoMatch = async () => {
                    _dlog('doAutoMatch: statsLoaded=' + statsLoaded.value + ' members=' + members.value.length);
                    if (!statsLoaded.value || members.value.length === 0) {
                        _dlog('doAutoMatch 跳过: 条件不满足');
                        return;
                    }
                    try {
                        // 剥离 Vue 响应式代理，避免 JSON 序列化问题
                        const res = await fetch('/api/match_members', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                members: JSON.parse(JSON.stringify(members.value)),
                                stats: JSON.parse(JSON.stringify(stats.value))
                            })
                        });
                        const json = await res.json();
                        if (json.success) {
                            nameMap.value = {};
                            const unmatchedList = [];
                            for (const r of json.results) {
                                if (r.status !== 'not_found') {
                                    nameMap.value[r.original] = r.matched;
                                } else {
                                    unmatchedList.push({...r, manualMatch: ''});
                                }
                            }
                            unmatched.value = unmatchedList;
                            matchDone.value = true;
                        }
                    } catch (e) {
                        console.error('[doAutoMatch] error:', e);
                        matchDone.value = true;
                    }
                };
                
                const matchMembers = async () => {
                    loading.value = true;
                    loadingText.value = '匹配成员...';
                    try {
                        const res = await fetch('/api/match_members', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ members: members.value, stats: stats.value })
                        });
                        const json = await res.json();
                        if (json.success) {
                            unmatched.value = json.unmatched.map(u => ({
                                ...u,
                                manualMatch: ''
                            }));
                            nameMap.value = {};
                            for (const r of json.results) {
                                if (r.status !== 'not_found') {
                                    nameMap.value[r.original] = r.matched;
                                }
                            }
                            matchDone.value = true;
                            if (unmatched.value.length > 0) {
                                showMatchModal.value = true;
                            } else {
                                alert('所有成员匹配成功！');
                            }
                        }
                    } catch (e) {
                        console.error('[matchMembers] error:', e);
                        alert('匹配失败: ' + e.message);
                    } finally {
                        loading.value = false;
                    }
                };
                
                const skipAll = () => {
                    for (const item of unmatched.value) {
                        nameMap.value[item.original] = null;
                    }
                    showMatchModal.value = false;
                };
                
                const confirmMatches = () => {
                    const stillUnmatched = [];
                    for (const item of unmatched.value) {
                        if (item.manualMatch) {
                            nameMap.value[item.original] = item.manualMatch;
                        } else {
                            nameMap.value[item.original] = null;  // 标记为跳过
                            stillUnmatched.push(item);
                        }
                    }
                    unmatched.value = stillUnmatched;
                    showMatchModal.value = false;
                };
                
                const runAssignment = async () => {
                    if (!statsLoaded.value || members.value.length === 0) {
                        alert('请先加载属性表和人员名单');
                        return;
                    }
                    loading.value = true;
                    loadingText.value = '执行分配...';
                    try {
                        const res = await fetch('/api/assign', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                members: JSON.parse(JSON.stringify(members.value)),
                                stats: JSON.parse(JSON.stringify(stats.value)),
                                name_map: JSON.parse(JSON.stringify(nameMap.value)),
                                threshold: threshold.value,
                                seed: randomSeed.value,
                                manual_captains: JSON.parse(JSON.stringify(manualCaptains.value)),
                                sort_by: sortBy.value
                            })
                        });
                        const json = await res.json();
                        if (json.success) {
                            bAssign.value = json.b_assign;
                            dAssign.value = json.d_assign;
                            sortedMembers.value = json.sorted;
                            assignmentDone.value = true;
                        } else {
                            alert('分配失败: ' + (json.error || '未知错误'));
                        }
                    } catch (e) {
                        alert('分配失败: ' + e.message);
                    } finally {
                        loading.value = false;
                    }
                };
                
                const getRank = (pos) => {
                    const m = bAssign.value[pos];
                    if (!m) return '-';
                    const idx = sortedMembers.value.findIndex(sm => sm.original === m.original);
                    return idx >= 0 ? idx + 1 : '-';
                };
                
                const getTeam = (pos) => {
                    const dIdx = parseInt(pos.replace('D', ''));
                    if (dIdx === 1 || (dIdx >= 2 && dIdx <= 8)) return '1队(A组)';
                    if (dIdx === 9 || (dIdx >= 10 && dIdx <= 16)) return '2队(B组)';
                    if (dIdx >= 17 && dIdx <= 24) return '其他队';
                    return '';
                };
                
                const exportExcel = async () => {
                    loading.value = true;
                    loadingText.value = '生成Excel...';
                    try {
                        // 1. POST 生成文件
                        const res = await fetch('/api/export', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                b_assign: bAssign.value,
                                d_assign: dAssign.value,
                                sorted: sortedMembers.value,
                                name_map: nameMap.value,
                                teams_data: teamsData.value,
                                section: selectedSection.value,
                                bench_list: benchMembers.value
                            })
                        });
                        const json = await res.json();
                        
                        if (!json.success) {
                            alert('生成失败: ' + (json.error || '未知错误'));
                            return;
                        }
                        
                        // 2. GET 下载文件
                        loadingText.value = '下载中...';
                        const link = document.createElement('a');
                        link.href = '/download/' + encodeURIComponent(json.filename);
                        link.download = json.filename;
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                        alert('导出成功！');
                    } catch (e) {
                        console.error(e);
                        alert('导出失败');
                    } finally {
                        loading.value = false;
                    }
                };
                
                const resetAll = () => {
                    assignmentDone.value = false;
                    bAssign.value = {};
                    dAssign.value = {};
                    sortedMembers.value = [];
                    manualCaptains.value = {B1:'',B2:'',B3:'',B4:'',B5:'',B6:''};
                };
                
                const moveToBench = (idx) => {
                    const m = members.value.splice(idx, 1)[0];
                    benchMembers.value.push(m);
                };
                
                const moveToMember = (idx) => {
                    const m = benchMembers.value.splice(idx, 1)[0];
                    members.value.push(m);
                };
                
                // Init: 一次性加载所有数据
                const init = async () => {
                    _dlog('init 开始...');
                    try {
                        const section = selectedSection.value || '团一';
                        const res = await fetch('/api/init?section=' + encodeURIComponent(section) + '&_t=' + Date.now());
                        _dlog('init 收到响应，等待解析...');
                        const json = await res.json();
                        _dlog('init 响应: status=' + res.status + ' success=' + json.success);
                        if (json.success) {
                            // Sections
                            if (json.sections && json.sections.length) {
                                sections.value = json.sections;
                                if (!selectedSection.value) {
                                    selectedSection.value = json.sections[0];
                                }
                                _dlog('sections: ' + JSON.stringify(json.sections));
                            }
                            // Stats
                            if (json.stats && Object.keys(json.stats).length) {
                                stats.value = json.stats;
                                statsLoaded.value = true;
                                statsCount.value = json.statsCount || 0;
                                statsFilename.value = '默认文件';
                                _dlog('stats: ' + Object.keys(json.stats).length + ' 条');
                            }
                            // Sort fields
                            if (json.sortFields && json.sortFields.length) {
                                sortFields.value = json.sortFields;
                                if (!sortFields.value.some(f => f.key === sortBy.value)) {
                                    sortBy.value = sortFields.value[0].key;
                                }
                            }
                            // Members
                            if (json.members && json.members.length) {
                                members.value = json.members;
                                benchMembers.value = json.bench || [];
                                teamsData.value = json.teams || {};
                                guanduFilename.value = '预置测试数据';
                                _dlog('members: ' + json.members.length + ' bench: ' + (json.bench||[]).length);
                            } else {
                                _dlog('members 为空! json.members=' + JSON.stringify(json.members));
                            }
                            // Match results
                            if (json.matchDone) {
                                nameMap.value = json.nameMap || {};
                                unmatched.value = (json.unmatched || []).map(r => ({...r, manualMatch: ''}));
                                matchDone.value = true;
                                _dlog('matchDone: nameMap=' + Object.keys(nameMap.value).length + ' unmatched=' + unmatched.value.length);
                            }
                            _dlog('init 完成');
                        } else {
                            _dlog('init 返回 success=false: ' + (res.data.error || ''));
                        }
                    } catch (e) {
                        _dlog('init 异常: ' + e.message);
                        console.error('[init] error:', e);
                    }
                };
                init();
                
                return {
                    sections, selectedSection, stats, statsLoaded, statsCount, statsFilename,
                    members, benchMembers, teamsData, guanduFilename, showMatchModal, unmatched,
                    nameMap, threshold, randomSeed, manualCaptains, matchDone, assignmentDone, loading, loadingText,
                    bAssign, dAssign, sortedMembers, debugLog,
                    bPositions, dPositions,
                    statNames, matchedCount, unmatchedCount,
                    getStatHp, getStatTotal, getStatPower, getHp, getHpClass, getSortValue,
                    sortBy, sortFields,
                    selectSection, reloadStats, uploadStatsFile, uploadGuanduFile,
                    matchMembers, skipAll, confirmMatches,
                    runAssignment, getRank, getTeam, exportExcel, resetAll
                };
            }
        }).mount('#app');
        console.log('[DEBUG] Mount done...');
        } catch(e) {
            console.log('[DEBUG] ERROR: ' + e.message);
            alert('Vue Error: ' + e.message);
        }
    </script>
</body>
</html>
